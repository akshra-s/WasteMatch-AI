# WasteMatch AI — Environment Configuration Template
# (Do NOT commit real secret values to version control)

# Gemini Vision & AI Classification API
GEMINI_API_KEY=

# Authentication Session Secret (Minimum 32 characters for HMAC-SHA256)
SESSION_SECRET=your-random-32-char-session-secret-here

# Optional: n8n Workflow Automation Webhook URL (Test or Production)
# e.g., https://your-n8n.instance.app/webhook/waste-match-event
N8N_WEBHOOK_URL=

# Optional: Shared Secret Token for n8n Webhook & Callback Authentication
N8N_WEBHOOK_SECRET=

# WasteMatch Backend Base URL (used by n8n to call back into API)
WASTEMATCH_API_URL=http://localhost:3000

# Frontend API URL (leave empty for same-origin relative /api calls)
VITE_AI_API_URL=
# WasteMatch AI — Environment Variables Example
# Copy to .env and configure for your deployment environment.

# 1. Gemini AI Vision (Server-Side Only - never exposed to browser)
GEMINI_API_KEY=
# Alternative: GOOGLE_API_KEY=

# 2. Session & Authentication Security
# Generate a cryptographically random 32+ character string
SESSION_SECRET=

# 3. n8n Circularity Automation Webhook / Form Trigger
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# 4. Geocoding Provider Configuration
# Supported providers: 'nominatim' (default, OSM rate-limited), 'google', 'custom', 'offline'
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_API_URL=

# 5. External Verified Industrial Facility API (Optional)
FACILITY_DATA_API_URL=
FACILITY_DATA_API_KEY=

# 6. Managed Cloud SQL (PostgreSQL) Integration (Set automatically upon Cloud SQL enablement)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# 7. Internal Service URLs
VITE_AI_API_URL=
WASTEMATCH_API_URL=